# Her Body Club — Git Ignore

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.code-workspace

# Node (if added later)
node_modules/
npm-debug.log*
yarn-error.log*

# Build output (if added later)
/dist
/build

# Environment variables
.env
.env.local
.env*.local

# Temp / scratch
*.tmp
*.temp
*.log

# Chrome debug profile
ChromeDebug/


# Raw photo source folders (not used by the website)
images/Body Transformation-*/
images/Transformation Photos-*/

# Too large for GitHub (540 MB) - compress or host on YouTube/Vimeo first
images/intro_vd.MOV

# Original photos (web-sized copies are in images/results/)
images/fix*.jpg
