# Her Body Club — Git Ignore

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.code-workspace

# Node (if added later)
node_modules/
npm-debug.log*
yarn-error.log*

# Build output (if added later)
/dist
/build

# Environment variables
.env
.env.local
.env*.local

# Temp / scratch
*.tmp
*.temp
*.log

# Chrome debug profile
ChromeDebug/


# Raw photo source folders (not used by the website)
images/Body Transformation-*/
images/Transformation Photos-*/

# Too large for GitHub (540 MB) - compress or host on YouTube/Vimeo first
images/intro_vd.MOV

# Original photos (web-sized copies are in images/results/)
images/fix*.jpg

# ---- Personal / private (repo is public — keep these on this computer only) ----
# Google Apps Script: contains your email and Google Sheet ID (runs on Google, not on the website)
Code.gs
*.gs
# Internal notes / setup guide
README.md
# Any private folder or file you add later, e.g. private/notes.txt or plan.private.md
private/
*.private.*
# Exported form responses / spreadsheets
*.csv
*.xlsx
*.xls

# ---- Images & videos ----
# Everything new in images/ and videos/ is ignored by default so personal or raw
# photos never get pushed by accident. Files ALREADY in the repo stay tracked
# (the live website needs them). To publish a new website image on purpose:
#   git add -f images/your-new-image.jpg
images/**
videos/**
# Raw / original media formats anywhere in the project
*.heic
*.HEIC
*.raw
*.dng
*.psd
*.mov
*.MOV
